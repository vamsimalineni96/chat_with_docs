# =============================================================================
# NVIDIA / NIM credentials & models
# =============================================================================
NVIDIA_API_KEY="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"
NVIDIA_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"
NVIDIA_LLM_MODEL="meta/llama-3.3-70b-instruct"
RERANK_MODEL="nv-rerank-qa-mistral-4b:1"

# Only used if you point the clients at a self-hosted NIM instead of the
# hosted NVIDIA endpoint. With the hosted API, leave these unused — the
# langchain-nvidia-ai-endpoints library resolves URLs internally.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_RERANK_URL="https://ai.api.nvidia.com/v1/retrieval/nvidia/reranking"

# Inference params
TEMPERATURE=0.3
TOP_P=0.7
MAX_TOKENS=1024
PROMPT_VERSION=v2

# =============================================================================
# Milvus
# =============================================================================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=docs
MILVUS_CACHE_COLLECTION_NAME=qa_cache
EMBED_DIM=1024
MILVUS_NPROBE=16
MILVUS_CONSISTENCY_LEVEL=Strong

# =============================================================================
# RAG / chunking
# =============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVE_K=40
TOP_K=5
INSERT_BATCH_SIZE=32

# =============================================================================
# Semantic cache
# =============================================================================
TOGGLE_CACHE=false
CACHE_MIN_SIMILARITY=0.9

# =============================================================================
# Conversation history
# =============================================================================
HISTORY_LIMIT=20
HISTORY_MAX_TURNS=6

# =============================================================================
# App / runtime
# =============================================================================
THREAD_POOL_MAX_WORKERS=4
DEFAULT_CONVERSATION_TITLE=New conversation
METRICS_DOMAIN=default
PDF_DIR=pdfs

# =============================================================================
# Redis (locks + URL)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_PREFIX=lock:conversation:
REDIS_LOCK_TTL_SECONDS=60

# =============================================================================
# Postgres
# =============================================================================
DATABASE_URL=postgresql+psycopg2://chatuser:chatpass@localhost:5432/chatdb

# =============================================================================
# Langfuse (LLM observability) — self-hosted
# UI: http://localhost:3000  (login: admin@local.dev / admin1234)
# Keys here match LANGFUSE_INIT_PROJECT_* in docker-compose.yml.
# =============================================================================
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-public
LANGFUSE_SECRET_KEY=sk-lf-local-dev-secret
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=1.0

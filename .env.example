# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# ─── Secrets (must be filled) ─────────────────────────────────────────────
# Anything in this block is sensitive. Treat the values like passwords.
NVIDIA_API_KEY=

# Stripe — two modes (set one, not both):
#
# Dev mode (stdio subprocess): set STRIPE_SECRET_KEY, leave STRIPE_MCP_URL blank.
#   The app spawns mcp_servers/stripe_support.py as a local subprocess.
#   Use a Restricted test key (rk_test_...) — never a live secret key.
#
# Production mode (SSE service): set STRIPE_MCP_URL, leave STRIPE_SECRET_KEY blank.
#   Run `python mcp_servers/stripe_support.py --transport sse --port 8001` as a
#   separate service (or container). The service holds the key; the app connects
#   to it over HTTP. Multiple app instances share one MCP service.
STRIPE_SECRET_KEY=
STRIPE_MCP_URL=

# Langfuse Cloud (https://cloud.langfuse.com → Project Settings → API Keys)
# For self-hosted, swap the host and use the bootstrapped keys from
# docker-compose.yml (LANGFUSE_INIT_PROJECT_*).
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── NVIDIA NIM model selection ───────────────────────────────────────────
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# Optional — set only when pointing at self-hosted NIM instances.
# NVIDIA_BASE_URL=
# NVIDIA_RERANK_URL=

# ─── LLM generation parameters ────────────────────────────────────────────
TEMPERATURE=0.1
TOP_P=0.7
MAX_TOKENS=1024
# Bump whenever prompt.yaml semantics change so the semantic cache invalidates.
PROMPT_VERSION=v2

# ─── Postgres (chat history) ──────────────────────────────────────────────
# Default below matches the docker-compose.yml service.
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5432/chatdb

# ─── Redis (per-conversation lock + semantic cache key) ──────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_PREFIX=lock:conversation:
REDIS_LOCK_TTL_SECONDS=60

# ─── Milvus (vector store) ────────────────────────────────────────────────
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=docs
MILVUS_CACHE_COLLECTION_NAME=qa_cache
EMBED_DIM=1024
MILVUS_NPROBE=16
MILVUS_CONSISTENCY_LEVEL=Strong

# ─── RAG / chunking ───────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# How many chunks Milvus pulls per query before reranking (>= TOP_K).
RETRIEVE_K=25
# How many chunks survive reranking and end up in the LLM prompt.
TOP_K=5
INSERT_BATCH_SIZE=32

# ─── Semantic cache ───────────────────────────────────────────────────────
TOGGLE_CACHE=false
CACHE_MIN_SIMILARITY=0.9

# ─── Conversation history ─────────────────────────────────────────────────
HISTORY_LIMIT=20
HISTORY_MAX_TURNS=6

# ─── App / runtime ────────────────────────────────────────────────────────
THREAD_POOL_MAX_WORKERS=4
# Multi-agent "both" path runs two LLM pipelines + aggregator. 180s covers it.
CHAT_TIMEOUT_SECONDS=180
DEFAULT_CONVERSATION_TITLE=New conversation
METRICS_DOMAIN=default
PDF_DIR=pdfs

# ─── Langfuse client tuning (defaults are usually fine) ──────────────────
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=1.0
